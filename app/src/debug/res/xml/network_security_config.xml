<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (replaces src/main/res/xml/network_security_config.xml): lets instrumented
     tests reach the local Firebase emulators, which use plain HTTP. 10.0.2.2 is the computer running
     the Android emulator. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
