// Made with Claude.

rules_version = '2';

// Cloud Storage Security Rules v1 (#34). Anything not matched below is denied. Files outside these
// paths (e.g. the older photos in listing_images/) stay readable through their download URLs, which
// carry a token and skip these rules. Tested in app/src/androidTest/.../rules/StorageRulesTest.
service firebase.storage {
  match /b/{bucket}/o {

    // A signed-in user with a verified name@epfl.ch email, as in firestore.rules.
    function isVerifiedEpfl() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower().matches('^[a-z0-9._-]+@epfl[.]ch$');
    }

    // Listing photos, uploaded by ListingRepositoryFirestore.
    match /listings/{listingId}/{photo} {
      allow read: if isVerifiedEpfl();

      // Placeholder limit until the camera screen sets the photo size.
      allow create, update: if canChangePhotos(listingId)
          && request.resource.size < 100 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');

      allow delete: if canChangePhotos(listingId);

      // The photos are uploaded before the listing document is written, so a folder whose listing
      // does not exist yet is open to any verified user (its random id is not public yet). Once the
      // listing exists, only its owner may change its photos.
      function canChangePhotos(listingId) {
        let listing = /databases/(default)/documents/listings/$(listingId);
        return isVerifiedEpfl()
            && (!firestore.exists(listing)
                || firestore.get(listing).data.ownerId == request.auth.uid);
      }
    }
  }
}
