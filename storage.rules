rules_version = '2';

// Placeholder so the Storage emulator can start: only signed-in users with a verified @epfl.ch
// email may read and write. The real per-path rules come with #34.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.matches('.*@epfl[.]ch$');
    }
  }
}
