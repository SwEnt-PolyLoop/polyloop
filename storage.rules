// Made with Claude.

rules_version = '2';

// Cloud Storage Security Rules v1 (#34). Anything not matched below is denied. Files outside these
// paths (e.g. the older photos in listing_images/) stay readable through their download URLs, which
// carry a token and skip these rules. Tested in app/src/androidTest/.../rules/StorageRulesTest.
service firebase.storage {
  match /b/{bucket}/o {

    // A signed-in user with a verified name@epfl.ch email, as in firestore.rules.
    function isVerifiedEpfl() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower().matches('^[a-z0-9._-]+@epfl[.]ch$');
    }

    // Listing photos, uploaded by ListingRepositoryFirestore as 0.jpg to 9.jpg (a listing has at
    // most 10), each tagged with the uid of the user who uploaded it.
    match /listings/{listingId}/{photo} {
      allow read: if isVerifiedEpfl();

      // In Storage rules, create covers every upload, even over a photo already stored here, and
      // update covers only metadata changes. Only the user who uploaded a photo may replace it,
      // change its metadata or delete it, even once its listing is deleted and its folder is open
      // again.
      allow create: if canChangePhotos(listingId)
          && (resource == null || isUploader())
          && isValidPhoto(photo);

      allow update: if canChangePhotos(listingId) && isUploader() && isValidPhoto(photo);

      allow delete: if canChangePhotos(listingId) && isUploader();

      // The photos are uploaded before the listing document is written, so a folder whose listing
      // does not exist yet is open to any verified user (its random id is not public yet). Once the
      // listing exists, only its owner may change its photos, and not while it is locked.
      function canChangePhotos(listingId) {
        let listing = /databases/(default)/documents/listings/$(listingId);
        return isVerifiedEpfl()
            && (!firestore.exists(listing)
                || (firestore.get(listing).data.ownerId == request.auth.uid
                    && !isLocked(firestore.get(listing).data)));
      }

      // The same lock as in firestore.rules (#341): an accepted rental of the listing ends today or
      // later. Cloud Functions keep bookedRanges sorted by first day, so the last one ends last.
      function isLocked(listing) {
        let ranges = listing.get('bookedRanges', []);
        return ranges.size() > 0 && ranges[ranges.size() - 1].end >= today();
      }

      // Today as YYYY-MM-DD, never later than in Zurich: UTC+1, as in firestore.rules.
      function today() {
        let now = request.time + duration.value(1, 'h');
        return string(now.year()) + '-' + twoDigits(now.month()) + '-' + twoDigits(now.day());
      }

      function twoDigits(number) {
        return (number < 10 ? '0' : '') + string(number);
      }

      // The signed-in user uploaded the photo stored here. A photo without the tag (uploaded
      // before it existed) matches nobody.
      function isUploader() {
        return resource.metadata.uploader == request.auth.uid;
      }

      // The photo being written: named 0.jpg to 9.jpg, tagged with the uid of the user writing it,
      // and an image. The in-app camera takes about 1440 x 1080 JPEGs at quality 80, far under this
      // limit.
      function isValidPhoto(name) {
        return name.matches('[0-9][.]jpg')
            && request.resource.metadata.uploader == request.auth.uid
            && request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*');
      }
    }

    // Profile photos, uploaded by ProfileRepositoryFirestore: one file per user, which only that
    // user may change.
    match /users/{uid}/profile.jpg {
      allow read: if isVerifiedEpfl();

      allow create, update: if isVerifiedEpfl()
          && request.auth.uid == uid
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');

      allow delete: if isVerifiedEpfl() && request.auth.uid == uid;
    }

    // Condition photos, uploaded by HandoverRepositoryFirestore: pickup photos while the rental is
    // Accepted, return photos while it is Active or Overdue. Only its two participants read and add
    // them; nobody replaces or deletes one, since they are evidence. The file is named after its
    // Firestore document, the uploader's slot {uid}_{phase}_{0..19}.jpg (#428), so a person cannot
    // add more than 20 per phase.
    match /rentals/{rentalId}/photos/{photo} {
      allow read: if isParticipant(rentalId);

      allow create: if isParticipant(rentalId)
          && isOwnSlotForTheStatus(rentalId, photo)
          && resource == null // no file there yet: create alone also let a photo be replaced
          && request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');

      // The uploader's own slot of a phase the rental's status takes photos in: PICKUP while it is
      // Accepted, RETURN while it is Active or Overdue.
      function isOwnSlotForTheStatus(rentalId, photo) {
        let status = firestore.get(rentalDoc(rentalId)).data.status;
        return (isOwnSlot(photo, 'PICKUP') && status == 'ACCEPTED')
            || (isOwnSlot(photo, 'RETURN') && status in ['ACTIVE', 'OVERDUE']);
      }

      function isOwnSlot(photo, phase) {
        return photo.matches(request.auth.uid + '_' + phase + '_([0-9]|1[0-9])[.]jpg');
      }

      function rentalDoc(rentalId) {
        return /databases/(default)/documents/rentals/$(rentalId);
      }

      function isParticipant(rentalId) {
        return isVerifiedEpfl()
            && request.auth.uid in firestore.get(rentalDoc(rentalId)).data.participants;
      }
    }
  }
}
