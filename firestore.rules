// Edited with Claude.

rules_version = '2';

// Firestore Security Rules v1 (#34). The schema is in docs/ARCHITECTURE.md, "Firestore schema".
// Anything not matched below is denied. Tested in app/src/androidTest/.../rules/FirestoreRulesTest.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    // A signed-in user with a verified name@epfl.ch email (subdomains rejected, like EpflEmail).
    function isVerifiedEpfl() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower().matches('^[a-z0-9._-]+@epfl[.]ch$');
    }

    function isUser(uid) {
      return isVerifiedEpfl() && request.auth.uid == uid;
    }

    function listingPath(listingId) {
      return /databases/$(database)/documents/listings/$(listingId);
    }

    function rentalPath(rentalId) {
      return /databases/$(database)/documents/rentals/$(rentalId);
    }

    // The fields a request changes, compared with the stored document.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A profile photo is "" or the download URL of the user's own users/{uid}/profile.jpg in this
    // project's bucket. Firestore rules cannot read the bucket name, so it is written in. The
    // Storage emulator's hosts are accepted with any bucket, so that the tests can use the URL of a
    // real upload; this holds in production too.
    function isOwnPhotoUrl(uid, url) {
      let path = '/o/users%2F' + uid + '%2Fprofile\\.jpg\\?alt=media&token=[0-9a-fA-F-]+';
      return url == ''
          || url.matches(
              'https://firebasestorage\\.googleapis\\.com/v0/b/polyloop-97543\\.firebasestorage\\.app'
              + path)
          || url.matches('http://(10\\.0\\.2\\.2|localhost|127\\.0\\.0\\.1):9199/v0/b/[^/]+' + path);
    }

    function isNonBlankString(value) {
      return value is string && value.trim().size() > 0;
    }

    // A YYYY-MM-DD string; such strings compare in date order.
    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Today as YYYY-MM-DD, never later than the date in Zurich, where rental dates are counted. The
    // rules only know UTC, and Zurich is UTC+1 in winter and UTC+2 in summer, so this is Zurich's
    // date in winter, and in summer it changes at 1 a.m. instead of midnight.
    function today() {
      let now = request.time + duration.value(1, 'h');
      return string(now.year()) + '-' + twoDigits(now.month()) + '-' + twoDigits(now.day());
    }

    function twoDigits(number) {
      return (number < 10 ? '0' : '') + string(number);
    }

    // A listing is locked, so its owner can neither change nor delete it, while an accepted rental
    // of it ends today or later (#341). Rules cannot loop over a list, so they read only the last
    // of its bookedRanges: Cloud Functions keep them sorted by first day, and they never overlap,
    // so that one ends last. A rental still active or overdue after its last day does not lock it.
    function isLocked(listing) {
      let ranges = listing.get('bookedRanges', []);
      return ranges.size() > 0 && ranges[ranges.size() - 1].end >= today();
    }

    // True if every item of a list of 3 to 10 items is a string. Rules cannot loop, so each index is
    // checked; an index past the end is skipped.
    function areStrings(list) {
      return list[0] is string && list[1] is string && list[2] is string
          && (list.size() <= 3 || list[3] is string)
          && (list.size() <= 4 || list[4] is string)
          && (list.size() <= 5 || list[5] is string)
          && (list.size() <= 6 || list[6] is string)
          && (list.size() <= 7 || list[7] is string)
          && (list.size() <= 8 || list[8] is string)
          && (list.size() <= 9 || list[9] is string);
    }

    // ---------- users ----------

    match /users/{uid} {
      allow read: if isVerifiedEpfl();

      // averageRating and reviewCount are written by Cloud Functions only.
      allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['name', 'email', 'photoUrl'])
          && request.resource.data.name is string
          && request.resource.data.email is string
          && request.resource.data.email.lower() == request.auth.token.email.lower()
          && request.resource.data.get('photoUrl', '') is string
          && isOwnPhotoUrl(uid, request.resource.data.get('photoUrl', ''));

      allow update: if isUser(uid)
          && changedKeys().hasOnly(['name', 'photoUrl'])
          && request.resource.data.name is string
          && request.resource.data.get('photoUrl', '') is string
          // Checked only when it changes, so an old stored value does not block a name change.
          && (!('photoUrl' in changedKeys())
              || isOwnPhotoUrl(uid, request.resource.data.get('photoUrl', '')));
    }

    // ---------- listings ----------

    match /listings/{listingId} {
      allow read: if isVerifiedEpfl();

      // bookedRanges is written by Cloud Functions only, when a request is accepted, and the areas
      // and points by geocodeListingAddresses: the app creates the area names empty and never
      // changes them. A deleted listing's id was public, so it cannot be created again while its
      // addresses are left over: the new owner could read them.
      allow create: if isVerifiedEpfl()
          && request.resource.data.ownerId == request.auth.uid
          && !request.resource.data.keys().hasAny(['bookedRanges', 'pickupPoint', 'dropOffPoint'])
          && request.resource.data.get('pickupArea', '') == ''
          && request.resource.data.get('dropOffArea', '') == ''
          && !exists(/databases/$(database)/documents/listings/$(listingId)/private/addresses)
          && isValidListing(request.resource.data);

      allow update: if isUser(resource.data.ownerId)
          && !isLocked(resource.data)
          && !changedKeys().hasAny(['ownerId', 'bookedRanges', 'pickupArea', 'dropOffArea',
              'pickupPoint', 'dropOffPoint'])
          && isValidListing(request.resource.data);

      allow delete: if isUser(resource.data.ownerId) && !isLocked(resource.data);

      // The same checks as Listing.canPublish in the app, for every status.
      function isValidListing(listing) {
        let required = ['ownerId', 'title', 'description', 'category', 'photoUrls',
            'pricePerDay', 'itemValue', 'availableFrom', 'availableTo', 'status'];
        return listing.keys().hasAll(required)
            && listing.keys().hasOnly(required.concat(['pickupArea', 'dropOffArea', 'pickupPoint',
                'dropOffPoint', 'bookedRanges']))
            && isNonBlankString(listing.title)
            && listing.title.size() <= 80
            && isNonBlankString(listing.description)
            && listing.description.size() <= 2000
            && listing.category in ['ELECTRONICS', 'SPORTS_OUTDOOR', 'BOOKS_COURSE_MATERIAL',
                'TOOLS_DIY', 'KITCHEN_HOME', 'MUSIC', 'OTHER']
            && listing.photoUrls is list
            && listing.photoUrls.size() >= 3
            && listing.photoUrls.size() <= 10
            && areStrings(listing.photoUrls)
            && listing.pricePerDay is int
            && listing.pricePerDay >= 1
            && listing.pricePerDay <= 99999
            && listing.itemValue is int
            && listing.itemValue >= 1
            && listing.itemValue <= 99999
            && isDate(listing.availableFrom)
            && isDate(listing.availableTo)
            && listing.availableFrom < listing.availableTo
            && listing.status in ['DRAFT', 'PUBLISHED']
            && listing.get('pickupArea', '') is string
            && listing.get('dropOffArea', '') is string;
      }

      // Exact addresses, readable only by the owner. getAfter() lets the owner write them in the
      // same batch that creates the listing; get() lets them be deleted with it. They are locked
      // with their listing.
      match /private/{docId} {
        allow read: if docId == 'addresses'
            && isUser(get(listingPath(listingId)).data.ownerId);

        allow create, update: if docId == 'addresses'
            && isOwnerBeforeOrAfter(listingId)
            && !isListingLocked(listingId)
            && request.resource.data.keys().hasOnly(['pickup', 'dropOff'])
            && isNonBlankString(request.resource.data.pickup)
            && isNonBlankString(request.resource.data.dropOff);

        allow delete: if docId == 'addresses'
            && isOwnerBeforeOrAfter(listingId)
            && !isListingLocked(listingId);

        function isOwnerBeforeOrAfter(listingId) {
          return (exists(listingPath(listingId))
                  && isUser(get(listingPath(listingId)).data.ownerId))
              || (existsAfter(listingPath(listingId))
                  && isUser(getAfter(listingPath(listingId)).data.ownerId));
        }

        // The stored listing is locked. A listing being created in the same batch is not stored
        // yet, and has no bookedRanges: clients never write them.
        function isListingLocked(listingId) {
          return exists(listingPath(listingId)) && isLocked(get(listingPath(listingId)).data);
        }
      }
    }

    // ---------- rentals ----------

    match /rentals/{rentalId} {
      // ownerId and borrowerId are listed as well as participants so that the My rentals queries
      // (where borrowerId == uid, where ownerId == uid) pass: Firestore only allows a query if the
      // rule holds for every document it could return, judging from the query's own filters.
      // Reading a missing rental is allowed, so getRental can return null for it.
      allow read: if isVerifiedEpfl()
          && (resource == null
              || request.auth.uid == resource.data.borrowerId
              || request.auth.uid == resource.data.ownerId
              || request.auth.uid in resource.data.participants);

      // Only the requestRental Cloud Function creates a rental. The participants may only update the
      // chat preview (#101) and the time they last opened the chat (#181), which the app saves by
      // itself.
      allow update: if isVerifiedEpfl()
          && request.auth.uid in resource.data.participants
          && changedKeys().size() > 0
          && changedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'lastReadAt'])
          && (!changedKeys().hasAny(['lastMessage', 'lastMessageAt'])
              || isChatPreview(request.resource.data))
          && (!changedKeys().hasAny(['lastReadAt']) || isOwnReadTime(request.resource.data));

      // The preview of a message just sent. Never empty: an empty preview means "no message yet",
      // which would hide the other person's red dot. The text is not checked against a real
      // message (that would need a Cloud Function).
      function isChatPreview(rental) {
        return rental.lastMessage is string
            && rental.lastMessage.size() > 0
            && rental.lastMessageAt == request.time;
      }

      // lastReadAt maps each participant's uid to when they last opened the chat. A user changes
      // only their own entry, and only to the server's current time.
      function isOwnReadTime(rental) {
        let reads = rental.lastReadAt;
        return reads is map
            && reads.diff(resource.data.get('lastReadAt', {})).affectedKeys()
                .hasOnly([request.auth.uid])
            && reads[request.auth.uid] == request.time;
      }

      // One conversation per rental, visible only to its two participants.
      match /messages/{messageId} {
        allow read: if isVerifiedEpfl()
            && request.auth.uid in get(rentalPath(rentalId)).data.participants;

        // SYSTEM messages are left to Cloud Functions. Messages cannot be edited or deleted.
        allow create: if isVerifiedEpfl()
            && request.auth.uid in get(rentalPath(rentalId)).data.participants
            && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt', 'type'])
            && request.resource.data.keys().hasAll(['senderId', 'text', 'sentAt', 'type'])
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.sentAt == request.time
            && request.resource.data.type == 'USER';
      }

      // Condition photos (#231). Each participant adds only their own photos: pickup photos while
      // the rental is Accepted, return photos while it is Active or Overdue (a late item is given
      // back the same way). They are evidence: never changed. Rules cannot count documents, so the
      // cap of 20 photos per person and phase (#428) is the id: a fixed slot, {uid}_{phase}_{0..19},
      // written once because photos are never replaced.
      match /photos/{photoId} {
        allow read: if isVerifiedEpfl()
            && request.auth.uid in get(rentalPath(rentalId)).data.participants;

        allow create: if isVerifiedEpfl()
            && request.auth.uid in get(rentalPath(rentalId)).data.participants
            && request.resource.data.keys().hasOnly(['takenBy', 'phase', 'takenAt', 'url'])
            && request.resource.data.keys().hasAll(['takenBy', 'phase', 'takenAt', 'url'])
            && request.resource.data.takenBy == request.auth.uid
            && request.resource.data.takenAt == request.time
            && request.resource.data.url is string
            && request.resource.data.phase in phaseStatuses().keys()
            && photoId.matches(
                request.auth.uid + '_' + request.resource.data.phase + '_([0-9]|1[0-9])')
            && get(rentalPath(rentalId)).data.status
                in phaseStatuses()[request.resource.data.phase];
      }

      // The statuses a rental must have for photos of each phase.
      function phaseStatuses() {
        return {'PICKUP': ['ACCEPTED'], 'RETURN': ['ACTIVE', 'OVERDUE']};
      }

      // The secret code of each handover's QR code (#434, #435), one document per phase (PICKUP,
      // RETURN), written by Cloud Functions only. Only the person who shows it reads it: the lender
      // at pickup, the borrower at return. The other one reads only its fingerprint, on the rental
      // (pickupCodeHash, returnCodeHash), which the update rule above keeps clients from writing.
      match /handoverCodes/{phase} {
        allow read: if isVerifiedEpfl() && request.auth.uid == codeShower(phase);

        function codeShower(phase) {
          let rental = get(rentalPath(rentalId)).data;
          return phase == 'PICKUP' ? rental.ownerId
              : phase == 'RETURN' ? rental.borrowerId
              : null;
        }
      }
    }

    // ---------- wallets ----------

    // The balance and its history are written by Cloud Functions only; a user reads their own.
    match /wallets/{uid} {
      allow read: if isUser(uid);
      allow write: if false;

      match /transactions/{transactionId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    // ---------- disputes ----------

    // One dispute per rental, at the rental's id, visible only to the rental's two participants.
    // Only Cloud Functions write it (proposeSplit, acceptSplit, escalateDispute and the hourly
    // escalateDisputes): no client write.
    // Reading the dispute of a rental that has none is allowed, so the app can read a missing
    // dispute as none.
    match /disputes/{rentalId} {
      allow read: if isVerifiedEpfl()
          && request.auth.uid in get(rentalPath(rentalId)).data.participants;
    }
  }
}
