// Edited with Claude.

rules_version = '2';

// Firestore Security Rules v1 (#34). The schema is in docs/ARCHITECTURE.md, "Firestore schema".
// Anything not matched below is denied. Tested in app/src/androidTest/.../rules/FirestoreRulesTest.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    // A signed-in user with a verified name@epfl.ch email (subdomains rejected, like EpflEmail).
    function isVerifiedEpfl() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower().matches('^[a-z0-9._-]+@epfl[.]ch$');
    }

    function isUser(uid) {
      return isVerifiedEpfl() && request.auth.uid == uid;
    }

    function listingPath(listingId) {
      return /databases/$(database)/documents/listings/$(listingId);
    }

    function rentalPath(rentalId) {
      return /databases/$(database)/documents/rentals/$(rentalId);
    }

    // The fields a request changes, compared with the stored document.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isNonBlankString(value) {
      return value is string && value.trim().size() > 0;
    }

    // A YYYY-MM-DD string; such strings compare in date order.
    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // True if every item of a list of 3 to 10 items is a string. Rules cannot loop, so each index is
    // checked; an index past the end is skipped.
    function areStrings(list) {
      return list[0] is string && list[1] is string && list[2] is string
          && (list.size() <= 3 || list[3] is string)
          && (list.size() <= 4 || list[4] is string)
          && (list.size() <= 5 || list[5] is string)
          && (list.size() <= 6 || list[6] is string)
          && (list.size() <= 7 || list[7] is string)
          && (list.size() <= 8 || list[8] is string)
          && (list.size() <= 9 || list[9] is string);
    }

    // Midnight UTC of a YYYY-MM-DD string, in milliseconds.
    function dateMillis(date) {
      return timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10])).toMillis();
    }

    // ---------- users ----------

    match /users/{uid} {
      allow read: if isVerifiedEpfl();

      // averageRating and reviewCount are written by Cloud Functions only.
      allow create: if isUser(uid)
          && request.resource.data.keys().hasOnly(['name', 'email', 'photoUrl'])
          && request.resource.data.name is string
          && request.resource.data.email is string
          && request.resource.data.email.lower() == request.auth.token.email.lower()
          && request.resource.data.get('photoUrl', '') is string;

      allow update: if isUser(uid)
          && changedKeys().hasOnly(['name', 'photoUrl'])
          && request.resource.data.name is string
          && request.resource.data.get('photoUrl', '') is string;
    }

    // ---------- listings ----------

    match /listings/{listingId} {
      allow read: if isVerifiedEpfl();

      // bookedRanges is written by Cloud Functions only, when a request is accepted, and the areas
      // and points by geocodeListingAddresses: the app creates the area names empty and never
      // changes them. A deleted listing's id was public, so it cannot be created again while its
      // addresses are left over: the new owner could read them.
      allow create: if isVerifiedEpfl()
          && request.resource.data.ownerId == request.auth.uid
          && !request.resource.data.keys().hasAny(['bookedRanges', 'pickupPoint', 'dropOffPoint'])
          && request.resource.data.get('pickupArea', '') == ''
          && request.resource.data.get('dropOffArea', '') == ''
          && !exists(/databases/$(database)/documents/listings/$(listingId)/private/addresses)
          && isValidListing(request.resource.data);

      allow update: if isUser(resource.data.ownerId)
          && !changedKeys().hasAny(['ownerId', 'bookedRanges', 'pickupArea', 'dropOffArea',
              'pickupPoint', 'dropOffPoint'])
          && isValidListing(request.resource.data);

      // Temporary exception until the acceptRental Cloud Function exists (#176): when the lender
      // accepts a request, the owner adds its dates to a published listing's bookedRanges, and
      // nothing else changes. Remove this with that Function.
      allow update: if isUser(resource.data.ownerId)
          && resource.data.status == 'PUBLISHED'
          && changedKeys().hasOnly(['bookedRanges'])
          && request.resource.data.bookedRanges is list
          && request.resource.data.bookedRanges.size()
              > resource.data.get('bookedRanges', []).size();

      allow delete: if isUser(resource.data.ownerId);

      // The same checks as Listing.canPublish in the app, for every status.
      function isValidListing(listing) {
        let required = ['ownerId', 'title', 'description', 'category', 'photoUrls',
            'pricePerDay', 'itemValue', 'availableFrom', 'availableTo', 'status'];
        return listing.keys().hasAll(required)
            && listing.keys().hasOnly(required.concat(['pickupArea', 'dropOffArea', 'pickupPoint',
                'dropOffPoint', 'bookedRanges']))
            && isNonBlankString(listing.title)
            && isNonBlankString(listing.description)
            && listing.category in ['ELECTRONICS', 'SPORTS_OUTDOOR', 'BOOKS_COURSE_MATERIAL',
                'TOOLS_DIY', 'KITCHEN_HOME', 'MUSIC', 'OTHER']
            && listing.photoUrls is list
            && listing.photoUrls.size() >= 3
            && listing.photoUrls.size() <= 10
            && areStrings(listing.photoUrls)
            && listing.pricePerDay is int
            && listing.pricePerDay >= 1
            && listing.pricePerDay <= 99999
            && listing.itemValue is int
            && listing.itemValue >= 1
            && listing.itemValue <= 99999
            && isDate(listing.availableFrom)
            && isDate(listing.availableTo)
            && listing.availableFrom < listing.availableTo
            && listing.status in ['DRAFT', 'PUBLISHED']
            && listing.get('pickupArea', '') is string
            && listing.get('dropOffArea', '') is string;
      }

      // Exact addresses, readable only by the owner. getAfter() lets the owner write them in the
      // same batch that creates the listing; get() lets them be deleted with it.
      match /private/{docId} {
        allow read: if docId == 'addresses'
            && isUser(get(listingPath(listingId)).data.ownerId);

        allow create, update: if docId == 'addresses'
            && isOwnerBeforeOrAfter(listingId)
            && request.resource.data.keys().hasOnly(['pickup', 'dropOff'])
            && isNonBlankString(request.resource.data.pickup)
            && isNonBlankString(request.resource.data.dropOff);

        allow delete: if docId == 'addresses' && isOwnerBeforeOrAfter(listingId);

        function isOwnerBeforeOrAfter(listingId) {
          return (exists(listingPath(listingId))
                  && isUser(get(listingPath(listingId)).data.ownerId))
              || (existsAfter(listingPath(listingId))
                  && isUser(getAfter(listingPath(listingId)).data.ownerId));
        }
      }
    }

    // ---------- rentals ----------

    match /rentals/{rentalId} {
      // ownerId and borrowerId are listed as well as participants so that the My rentals queries
      // (where borrowerId == uid, where ownerId == uid) pass: Firestore only allows a query if the
      // rule holds for every document it could return, judging from the query's own filters.
      // Reading a missing rental is allowed, so getRental can return null for it.
      allow read: if isVerifiedEpfl()
          && (resource == null
              || request.auth.uid == resource.data.borrowerId
              || request.auth.uid == resource.data.ownerId
              || request.auth.uid in resource.data.participants);

      // Temporary exception to the core rule, until the requestRental Cloud Function exists: the
      // borrower creates the request, with status REQUESTED only and no money reserved.
      allow create: if isVerifiedEpfl() && isValidNewRental(request.resource.data);

      // Afterwards the participants may only update the chat preview (#101).
      allow update: if isVerifiedEpfl()
          && request.auth.uid in resource.data.participants
          && changedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessageAt == request.time;

      // Temporary exception to the core rule, until the acceptRental and declineRental Cloud
      // Functions exist (#176): the lender answers a REQUESTED rental. Accepting also stores the
      // exact addresses; declining changes nothing else. Remove this with those Functions.
      allow update: if isVerifiedEpfl()
          && request.auth.uid == resource.data.ownerId
          && resource.data.status == 'REQUESTED'
          && changedKeys().hasOnly(['status', 'pickupAddress', 'returnAddress'])
          && (
              (request.resource.data.status == 'DECLINED'
                  && request.resource.data.get('pickupAddress', '') == resource.data.get('pickupAddress', '')
                  && request.resource.data.get('returnAddress', '') == resource.data.get('returnAddress', ''))
              || (request.resource.data.status == 'ACCEPTED'
                  && isNonBlankString(request.resource.data.get('pickupAddress', ''))
                  && isNonBlankString(request.resource.data.get('returnAddress', '')))
          );

      function isValidNewRental(rental) {
        let fields = ['listingId', 'listingTitle', 'listingPhotoUrl', 'ownerId', 'ownerName',
            'borrowerId', 'borrowerName', 'participants', 'startDate', 'endDate', 'status',
            'pricePerDay', 'totalPrice', 'pickupArea', 'dropOffArea', 'pickupAddress',
            'returnAddress', 'createdAt', 'lastMessage', 'lastMessageAt'];
        let listing = get(listingPath(rental.listingId)).data;
        return rental.keys().hasOnly(fields)
            && rental.keys().hasAll(fields)
            && rental.borrowerId == request.auth.uid
            && rental.ownerId == listing.ownerId
            && rental.ownerId != rental.borrowerId
            && rental.participants == [rental.ownerId, rental.borrowerId]
            && rental.ownerName is string
            && rental.borrowerName is string
            && rental.status == 'REQUESTED'
            && listing.status == 'PUBLISHED'
            // The copies of the listing match it.
            && rental.listingTitle == listing.title
            // The first photo, or "" for a listing from before the photo rules that has none.
            && rental.listingPhotoUrl == (listing.get('photoUrls', []).size() > 0
                ? listing.photoUrls[0] : '')
            && rental.pricePerDay == listing.pricePerDay
            && rental.pickupArea == listing.get('pickupArea', '')
            && rental.dropOffArea == listing.get('dropOffArea', '')
            && isDate(rental.startDate)
            && isDate(rental.endDate)
            && rental.startDate <= rental.endDate
            && rental.startDate >= listing.availableFrom
            && rental.endDate <= listing.availableTo
            // totalPrice is pricePerDay × days, both days included (Rental.totalPrice).
            && rental.totalPrice is int
            && rental.totalPrice * 86400000
                == rental.pricePerDay
                    * (dateMillis(rental.endDate) - dateMillis(rental.startDate) + 86400000)
            // The exact addresses stay empty until the lender accepts.
            && rental.pickupAddress == ''
            && rental.returnAddress == ''
            && rental.createdAt == request.time
            && rental.lastMessageAt == request.time
            && rental.lastMessage == '';
      }

      // One conversation per rental, visible only to its two participants.
      match /messages/{messageId} {
        allow read: if isVerifiedEpfl()
            && request.auth.uid in get(rentalPath(rentalId)).data.participants;

        // SYSTEM messages are left to Cloud Functions. Messages cannot be edited or deleted.
        allow create: if isVerifiedEpfl()
            && request.auth.uid in get(rentalPath(rentalId)).data.participants
            && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt', 'type'])
            && request.resource.data.keys().hasAll(['senderId', 'text', 'sentAt', 'type'])
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.sentAt == request.time
            && request.resource.data.type == 'USER';
      }
    }
  }
}
